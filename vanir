#!/usr/bin/env bash
set -euo pipefail

TERM_NAME="Terminus"
TERM_RELEASE="Hydromel"

CONFIG="${VANIR_CONFIG:-/etc/config.scm}"
TERM_DIR="${VANIR_DIR:-/etc/terminus}"
HOME_CONFIG="${VANIR_HOME_CONFIG:-$HOME/.config/terminus/home.scm}"
BIFROST_FILE="${VANIR_BIFROST_FILE:-$HOME/.config/terminus/bifrost.nix}"
bifrost_init() {
  mkdir -p "$(dirname "$BIFROST_FILE")"

  if [ -f "$BIFROST_FILE" ]; then
    echo "Bifrost file already exists: $BIFROST_FILE"
    return 0
  fi

  cat > "$BIFROST_FILE" <<'EOF'
{ pkgs ? import <nixpkgs> {} }:

with pkgs; [
  hello
  fastfetch
]
EOF

  echo "Created Bifrost file: $BIFROST_FILE"
}

bifrost_file() {
  echo "$BIFROST_FILE"
  if [ -f "$BIFROST_FILE" ]; then
    echo
    cat "$BIFROST_FILE"
  else
    echo "Bifrost file does not exist yet."
    echo "Run: vanir bifrost init"
  fi
}

bifrost_edit() {
  mkdir -p "$(dirname "$BIFROST_FILE")"
  "${EDITOR:-nano}" "$BIFROST_FILE"
}

bifrost_apply() {
  [ -f "$BIFROST_FILE" ] || die "Bifrost file not found: $BIFROST_FILE"
  need nix-env
  nix-env -irf "$BIFROST_FILE"
}

bifrost_sync() {
  bifrost_update
  bifrost_apply
  bifrost_integrate
}

die() {
  echo "vanir: $*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

root_guix() {
  if [ "$(id -u)" -eq 0 ]; then
    GUIX_PROFILE="$HOME/.config/guix/current"
    [ -f "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
    hash guix 2>/dev/null || true
    guix "$@"
  else
    sudo -H bash -lc '
      GUIX_PROFILE="$HOME/.config/guix/current"
      [ -f "$GUIX_PROFILE/etc/profile" ] && . "$GUIX_PROFILE/etc/profile"
      hash guix 2>/dev/null || true
      guix "$@"
    ' bash "$@"
  fi
}

status() {
  echo "$TERM_NAME $TERM_RELEASE"
  echo "------------------"
  printf "%-14s %s\n" "Host:" "$(hostname)"
  printf "%-14s %s\n" "Kernel:" "$(uname -r)"

  if command -v guix >/dev/null 2>&1; then
    printf "%-14s %s\n" "Core:" "$(guix --version | head -n1)"
  else
    printf "%-14s %s\n" "Core:" "Guix not found"
  fi

  if command -v nix >/dev/null 2>&1; then
    printf "%-14s %s\n" "Bifrost:" "$(nix --version)"
  else
    printf "%-14s %s\n" "Bifrost:" "not available"
  fi

  if pgrep -x nix-daemon >/dev/null 2>&1; then
    printf "%-14s %s\n" "Bifrost svc:" "running"
  else
    printf "%-14s %s\n" "Bifrost svc:" "not running"
  fi

  if command -v nmcli >/dev/null 2>&1; then
    wifi="$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device | awk -F: '$2=="wifi"{print $1 " " $3 " " $4; exit}')"
    printf "%-14s %s\n" "Wi-Fi:" "${wifi:-not found}"
  fi

  if command -v powerprofilesctl >/dev/null 2>&1; then
    profile="$(powerprofilesctl get 2>/dev/null || true)"
    printf "%-14s %s\n" "Power:" "${profile:-no power profile daemon}"
  fi

  if command -v upower >/dev/null 2>&1; then
    battery="$(upower -d | awk '
      /state:/ && !s { state=$2; s=1 }
      /percentage:/ && !p { pct=$2; p=1 }
      /energy-rate:/ && !r { rate=$2" "$3; r=1 }
      END {
        if (pct || state || rate) print pct " " state " (" rate ")"
      }')"
    printf "%-14s %s\n" "Battery:" "${battery:-unknown}"
  fi

  printf "%-14s %s\n" "Root:" "$(df -h / | awk 'NR==2{print $3 " used / " $2 " total (" $5 ")"}')"

  if [ -d /gnu/store ]; then
    printf "%-14s %s\n" "/gnu/store:" "$(du -sh /gnu/store 2>/dev/null | awk '{print $1}')"
  fi

  if [ -d /nix/store ]; then
    printf "%-14s %s\n" "/nix/store:" "$(du -sh /nix/store 2>/dev/null | awk '{print $1}')"
  fi
}

describe() {
  echo "== Terminus core =="
  root_guix describe || true
  echo

  echo "== Current system =="
  root_guix system describe || true
  echo

  echo "== Bifrost channels =="
  if command -v nix-channel >/dev/null 2>&1; then
    nix-channel --list
  else
    echo "nix-channel not found"
  fi
}

doctor() {
  status
  echo
  echo "== Service checks =="

  if command -v herd >/dev/null 2>&1; then
    if [ "$(id -u)" -eq 0 ]; then
      herd status nix-daemon 2>/dev/null || true
    else
      sudo herd status nix-daemon 2>/dev/null || true
    fi
  fi

  echo
  echo "== Store checks =="
  [ -d /gnu/store ] && echo "/gnu/store exists"
  [ -d /nix/store ] && echo "/nix/store exists"

  echo
  echo "== Network checks =="
  if command -v nmcli >/dev/null 2>&1; then
    nmcli device
  else
    echo "nmcli not found"
  fi
}

rebuild() {
  local cfg="${1:-$CONFIG}"
  root_guix system reconfigure "$cfg"
}

pull() {
  root_guix pull
}

update() {
  local all="no"

  if [ "${1:-}" = "--all" ]; then
    all="yes"
  fi

  root_guix pull
  root_guix system reconfigure "$CONFIG"

  if [ "$all" = "yes" ]; then
    bifrost_update
  fi
}

rollback() {
  root_guix system roll-back
}

generations() {
  root_guix system list-generations "$@"
}

delete_generations() {
  [ "$#" -gt 0 ] || die "usage: vanir delete-generations PATTERN"
  root_guix system delete-generations "$@"
}

home() {
  local cfg="${1:-$HOME_CONFIG}"
  [ -f "$cfg" ] || die "home config not found: $cfg"
  guix home reconfigure "$cfg"
}

core_search() {
  [ "$#" -gt 0 ] || die "usage: vanir search PACKAGE"
  guix search "$@"
}

core_find() {
  [ "$#" -gt 0 ] || die "usage: vanir find PACKAGE"

  echo "== Core results =="
  guix search "$@" || true

  echo
  echo "== Bifrost results =="
  bifrost_search "$@" || true
}

core_install() {
  [ "$#" -gt 0 ] || die "usage: vanir install PACKAGE..."
  guix install "$@"
}

core_remove() {
  [ "$#" -gt 0 ] || die "usage: vanir remove PACKAGE..."
  guix remove "$@"
}

core_upgrade() {
  guix upgrade "$@"
}

core_list() {
  guix package --list-installed
}

core_shell() {
  [ "$#" -gt 0 ] || die "usage: vanir shell PACKAGE..."
  guix shell "$@"
}

core_run() {
  [ "$#" -gt 0 ] || die "usage: vanir run PACKAGE [COMMAND...]"
  local pkg="$1"
  shift || true

  if [ "$#" -gt 0 ]; then
    guix shell "$pkg" -- "$@"
  else
    guix shell "$pkg" -- "$pkg"
  fi
}

core_gc() {
  root_guix gc "$@"
}

bifrost_channels() {
  need nix-channel
  nix-channel --list
}

bifrost_update() {
  need nix-channel
  nix-channel --update
}

bifrost_search() {
  [ "$#" -gt 0 ] || die "usage: vanir bifrost search PACKAGE"
  need nix-env
  local q="$*"
  nix-env -qaP ".*${q}.*"
}

bifrost_install() {
  [ "$#" -gt 0 ] || die "usage: vanir bifrost install PACKAGE..."
  need nix-env

  for pkg in "$@"; do
    nix-env -iA "nixpkgs.$pkg"
  done
}

bifrost_remove() {
  [ "$#" -gt 0 ] || die "usage: vanir bifrost remove PACKAGE..."
  need nix-env
  nix-env -e "$@"
}

bifrost_upgrade() {
  need nix-env
  nix-env -u "$@"
}

bifrost_list() {
  need nix-env
  nix-env -q
}

bifrost_shell() {
  [ "$#" -gt 0 ] || die "usage: vanir bifrost shell PACKAGE..."
  need nix-shell
  nix-shell -p "$@"
}

bifrost_run() {
  [ "$#" -gt 0 ] || die "usage: vanir bifrost run PACKAGE [COMMAND...]"
  need nix-shell

  local pkg="$1"
  shift || true

  if [ "$#" -gt 0 ]; then
    nix-shell -p "$pkg" --run "$*"
  else
    nix-shell -p "$pkg" --run "$pkg"
  fi
}

bifrost_gc() {
  need nix-collect-garbage
  nix-collect-garbage "$@"
}

bifrost_optimise() {
  need nix-store
  nix-store --optimise
}

gc() {
  if [ "${1:-}" = "--all" ]; then
    shift || true
    core_gc "$@"
    bifrost_gc "$@"
  else
    core_gc "$@"
  fi
}

clean() {
  gc "$@"
}

runes() {
  cat <<'EOF'
Vanir runes — Terminus command reference
========================================

System
------
vanir master file location
~/.local/bin/vanir

vanir status
  Show Terminus status: kernel, core, Bifrost, Wi-Fi, power, battery, stores.

vanir doctor
  Deeper health check: status, services, stores, network devices.

vanir describe
  Show Guix/Nonguix channels, system generation, and Bifrost channels.

vanir record
  Record the current Terminus state into a timestamped folder under
  ~/.config/terminus/records/.

vanir record NAME
  Record the current Terminus state under a named folder.
  Example: vanir record hydromel-bifrost-working

vanir rebuild
  Rebuild Terminus from /etc/config.scm.

vanir rebuild /path/to/config.scm
  Rebuild Terminus from a specific system config.

vanir starfield
  Install/update the Terminus login starfield: a GNOME autostart helper
  that waits for the session to settle, then runs vanir theme repair so
  the aesthetics of the vessel are reasserted every login.

vanir starfield run
  Run the Starfield helper immediately.

vanir starfield status
  Show Starfield autostart state and recent log output.

vanir starfield disable
  Remove the Starfield login autostart entry.

vanir login-background
  Install the Terminus GDM pre-login background.
  Defaults to ~/Pictures/station3.png and writes it to
  /etc/terminus/login-background.png for the GDM greeter.

vanir login-background /path/to/image.png
  Install a specific image as the Terminus GDM pre-login background.

vanir theme status
  Show the active Terminus theme declaration and current GNOME theme settings.

vanir theme init
  Create ~/.config/terminus/theme.scm with the default pinned theme declaration.

vanir theme edit
  Edit the declarative Terminus theme file.

vanir theme apply
  Clone/update the pinned theme repository, install GTK/Shell/icon files,
  then enforce the full Terminus desktop state.

vanir theme reset
  Reset GNOME theme settings back to Adwaita defaults.

vanir theme enforce
  Declaratively assert the full Terminus desktop state: Prism GTK/icon/shell
  theme, User Themes, Dash-to-Panel, Terminus show-apps icon, Fastfetch wrapper,
  Ptyxis wrapper/launcher, and login reapply helper.

vanir theme repair
  Alias for vanir theme enforce.

vanir pull
  Update Guix/Nonguix channel state.

vanir update
  Pull Guix/Nonguix and rebuild Terminus.

vanir update --all
  Pull Guix/Nonguix, rebuild Terminus, and update Bifrost/Nixpkgs.

vanir event one
  Trigger a full Terminus Event One: record pre-state, serialise unstable
  Guix user-profile packages into Core, update/rebuild Core, sync Bifrost,
  remove absorbed user-profile packages after success, integrate launchers,
  and record the resulting timeline.

vanir event one --gc
  Run Event One, then garbage collect old Core and Bifrost store paths.

vanir rollback
  Roll back the Guix system generation.

vanir generations
  List Guix system generations.

vanir delete-generations PATTERN
  Delete old Guix system generations matching PATTERN.

vanir home
  Reconfigure Guix Home using ~/.config/terminus/home.scm.

vanir gc
  Garbage collect Guix store items.

vanir gc --all
  Garbage collect Guix and Bifrost store items.

vanir clean
  Alias for vanir gc.

vanir serialise
  Serialise Guix user-profile packages into /etc/terminus/serialised-packages.scm.

vanir serialise absorb
  Serialise Guix user-profile packages, rebuild Terminus, then remove the absorbed
  packages from the Guix user profile after the rebuild succeeds.

vanir serialise remove-user
  Remove the last serialised package set from the Guix user profile.

vanir serialise status
  Show Guix user-profile packages and serialised package file locations.

vanir serialise file
  Print the generated serialised package Scheme file.

Core
----
Core = Guix/Nonguix.

vanir search PACKAGE
  Search core packages.

vanir find PACKAGE
  Search both core and Bifrost.

vanir install PACKAGE...
  Install packages into the Guix user profile.

vanir remove PACKAGE...
  Remove packages from the Guix user profile.

vanir upgrade
  Upgrade Guix user profile packages.

vanir list
  List installed Guix user profile packages.

vanir shell PACKAGE...
  Enter a temporary Guix shell.

vanir run PACKAGE
  Run PACKAGE through a temporary Guix shell.

vanir core integrate
  Integrate Guix user-profile desktop launchers into GNOME.
  Copies .desktop files from ~/.guix-profile, patches Exec paths,
  resolves icons, and refreshes the desktop app database.

Bifrost
-------
Bifrost = Nixpkgs bridge.

vanir bifrost channels
  List Bifrost channels.

vanir bifrost update
  Update Bifrost/Nixpkgs channels.

vanir bifrost search PACKAGE
  Search Bifrost packages.

vanir bifrost install PACKAGE...
  Install packages into the Nix user profile.

vanir bifrost remove PACKAGE...
  Remove packages from the Nix user profile.

vanir bifrost upgrade
  Upgrade Nix user profile packages.

vanir bifrost list
  List installed Nix user profile packages.

vanir bifrost shell PACKAGE...
  Enter a temporary Nix shell.

vanir bifrost run PACKAGE
  Run PACKAGE through a temporary Nix shell.

vanir bifrost gc
  Garbage collect old Bifrost store paths.

vanir bifrost optimise
  Optimise/deduplicate the Nix store.

vanir bifrost init
  Create ~/.config/terminus/bifrost.nix if it does not exist.

vanir bifrost file
  Show the Bifrost package file path and contents.

vanir bifrost edit
  Edit the Bifrost package file.

vanir bifrost apply
  Apply the Bifrost package file to the Nix user profile.

vanir bifrost sync
  Update Bifrost/Nixpkgs channels, then apply the Bifrost package file.

Bifrost shorthand
-----------------
vanir search bifrost:PACKAGE
vanir install bifrost:PACKAGE
vanir remove bifrost:PACKAGE
vanir shell bifrost:PACKAGE
vanir run bifrost:PACKAGE


Terminology
-----------
Terminus
  The system.

Vanir
  The operator command.

Core
  Guix/Nonguix: system spine, services, kernel, firmware, native packages.

Bifrost
  Nixpkgs bridge: extended package universe and temporary package shells.

EOF
}

