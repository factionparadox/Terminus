bifrost_find_icon() {
  icon="$1"

  [ -z "$icon" ] && return 1

  case "$icon" in
    /*)
      [ -f "$icon" ] && printf '%s\n' "$icon"
      return
      ;;
  esac

  {
    find -L "$HOME/.nix-profile" /nix/store -type f \
      \( -path "*/share/icons/hicolor/*/apps/$icon.png" \
         -o -path "*/share/icons/hicolor/*/apps/$icon.svg" \
         -o -path "*/share/icons/hicolor/*/apps/$icon.svgz" \
         -o -path "*/share/pixmaps/$icon.png" \
         -o -path "*/share/pixmaps/$icon.svg" \
         -o -path "*/share/pixmaps/$icon.xpm" \) \
      2>/dev/null

    find -L "$HOME/.nix-profile" /nix/store -type f \
      \( -iname "$icon.png" -o -iname "$icon.svg" -o -iname "$icon.svgz" -o -iname "$icon.xpm" \
         -o -iname "*$icon*.png" -o -iname "*$icon*.svg" -o -iname "*$icon*.svgz" -o -iname "*$icon*.xpm" \) \
      2>/dev/null
  } \
    | grep -E '/share/(icons|pixmaps)/|/share/.*icons/' \
    | grep -viE 'tray|symbolic|mono' \
    | awk '!seen[$0]++' \
    | sort -Vr \
    | head -n 1
}
bifrost_integrate() {
  mkdir -p "$HOME/.local/share/applications"

  if [ ! -d "$HOME/.nix-profile/share/applications" ]; then
    die "Bifrost applications directory not found"
  fi

  for f in "$HOME"/.nix-profile/share/applications/*.desktop; do
    [ -e "$f" ] || continue

    out="$HOME/.local/share/applications/$(basename "$f")"

    rm -f "$out"
    cp -L "$f" "$out"

    sed -i '/^TryExec=/d' "$out"
    sed -i "s|^Exec=|Exec=env PATH=$HOME/.nix-profile/bin:$HOME/.local/bin:$HOME/.guix-profile/bin:/run/current-system/profile/bin:/usr/bin:/bin |" "$out"

    icon="$(grep -m1 '^Icon=' "$out" | cut -d= -f2-)"
    icon_path="$(bifrost_find_icon "$icon" || true)"

    if [ -n "$icon_path" ]; then
      sed -i "s|^Icon=.*|Icon=$icon_path|" "$out"
    fi
  done

  update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true

  echo "Bifrost desktop launchers integrated."
  echo "GNOME should show Bifrost apps after logging out/in or rebooting."
}

record() {
  name="${1:-$(date +%Y%m%d-%H%M%S)}"
  safe_name="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-')"
  dir="$HOME/.config/terminus/records/$safe_name"

  mkdir -p "$dir"

  echo "Recording Terminus state: $dir"

  cp "$0" "$dir/vanir" 2>/dev/null || true

  [ -f "$CONFIG" ] && cp "$CONFIG" "$dir/config.scm" 2>/dev/null || true
  [ -f "$BIFROST_FILE" ] && cp "$BIFROST_FILE" "$dir/bifrost.nix" 2>/dev/null || true
  [ -f "$HOME/.config/fastfetch/config.jsonc" ] && cp "$HOME/.config/fastfetch/config.jsonc" "$dir/fastfetch-config.jsonc" 2>/dev/null || true

  guix describe > "$dir/guix-describe-user.txt" 2>/dev/null || true
  nix-channel --list > "$dir/bifrost-channels.txt" 2>/dev/null || true
  vanir bifrost list > "$dir/bifrost-installed.txt" 2>/dev/null || true
  vanir status > "$dir/status.txt" 2>/dev/null || true

  if command -v fastfetch >/dev/null 2>&1; then
    fastfetch > "$dir/fastfetch.txt" 2>/dev/null || true
  fi

  echo "Record written:"
  echo "$dir"
}

core_find_icon() {
  icon="$1"

  [ -z "$icon" ] && return 1

  case "$icon" in
    /*)
      [ -f "$icon" ] && printf '%s\n' "$icon"
      return
      ;;
  esac

  {
    find -L "$HOME/.guix-profile" /run/current-system/profile /gnu/store -type f \
      \( -path "*/share/icons/hicolor/*/apps/$icon.png" \
         -o -path "*/share/icons/hicolor/*/apps/$icon.svg" \
         -o -path "*/share/icons/hicolor/*/apps/$icon.svgz" \
         -o -path "*/share/pixmaps/$icon.png" \
         -o -path "*/share/pixmaps/$icon.svg" \
         -o -path "*/share/pixmaps/$icon.xpm" \) \
      2>/dev/null

    find -L "$HOME/.guix-profile" /run/current-system/profile /gnu/store -type f \
      \( -iname "$icon.png" -o -iname "$icon.svg" -o -iname "$icon.svgz" -o -iname "$icon.xpm" \
         -o -iname "*$icon*.png" -o -iname "*$icon*.svg" -o -iname "*$icon*.svgz" -o -iname "*$icon*.xpm" \) \
      2>/dev/null
  } \
    | grep -E '/share/(icons|pixmaps)/|/share/.*icons/' \
    | grep -viE 'tray|symbolic|mono' \
    | awk '!seen[$0]++' \
    | sort -Vr \
    | head -n 1
}

core_integrate() {
  mkdir -p "$HOME/.local/share/applications"

  if [ ! -d "$HOME/.guix-profile/share/applications" ]; then
    echo "No Core user application launchers found in ~/.guix-profile/share/applications"
    return 0
  fi

  for f in "$HOME"/.guix-profile/share/applications/*.desktop; do
    [ -e "$f" ] || continue

    out="$HOME/.local/share/applications/$(basename "$f")"

    rm -f "$out"
    cp -L "$f" "$out"

    sed -i '/^TryExec=/d' "$out"
    sed -i "s|^Exec=|Exec=env PATH=$HOME/.guix-profile/bin:$HOME/.local/bin:/run/current-system/profile/bin:$HOME/.nix-profile/bin:/usr/bin:/bin |" "$out"

    icon="$(grep -m1 '^Icon=' "$out" | cut -d= -f2-)"
    icon_path="$(core_find_icon "$icon" || true)"

    if [ -n "$icon_path" ]; then
      sed -i "s|^Icon=.*|Icon=$icon_path|" "$out"
    fi
  done

  update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true

  echo "Core desktop launchers integrated."
  echo "GNOME should show Core user apps after logging out/in or rebooting."
}

THEME_CONFIG="$HOME/.config/terminus/theme.scm"

theme_value() {
  key="$1"

  [ -f "$THEME_CONFIG" ] || die "theme config not found: $THEME_CONFIG"

  TERMINUS_THEME_KEY="$key" TERMINUS_THEME_FILE="$THEME_CONFIG" guile -c '
(define file (getenv "TERMINUS_THEME_FILE"))
(define key (string->symbol (getenv "TERMINUS_THEME_KEY")))
(define cfg (call-with-input-file file read))
(define pair (assoc key cfg))
(if pair
    (let ((value (cdr pair)))
      (cond
       ((string? value) (display value))
       ((boolean? value) (display (if value "#t" "#f")))
       (else (write value)))))
'
}

theme_init() {
  mkdir -p "$HOME/.config/terminus"

  if [ -f "$THEME_CONFIG" ]; then
    echo "Theme config already exists:"
    echo "  $THEME_CONFIG"
    return 0
  fi

  cat > "$THEME_CONFIG" <<'EOF'
((name . "gnome-prism")
 (repo . "https://github.com/zachfeldman/gnome-prism.git")
 (commit . "9380959")
 (gtk-theme . "gnome-prism")
 (shell-theme . "gnome-prism")
 (icon-theme . "gnome-prism")
 (dark . #t))
EOF

  echo "Theme config written:"
  echo "  $THEME_CONFIG"
}

theme_apply() {
  command -v git >/dev/null 2>&1 || die "git is not installed"
  command -v gsettings >/dev/null 2>&1 || die "gsettings is not available"
  command -v guile >/dev/null 2>&1 || die "guile is not available"

  name="$(theme_value name)"
  repo="$(theme_value repo)"
  commit="$(theme_value commit)"
  gtk_theme="$(theme_value gtk-theme)"
  shell_theme="$(theme_value shell-theme)"
  icon_theme="$(theme_value icon-theme)"
  dark="$(theme_value dark)"

  [ -n "$name" ] || die "theme name missing"
  [ -n "$repo" ] || die "theme repo missing"
  [ -n "$commit" ] || die "theme commit missing"

  src="$HOME/.local/share/terminus/themes/$name"

  mkdir -p "$HOME/.local/share/terminus/themes"
  mkdir -p "$HOME/.local/share/themes"
  mkdir -p "$HOME/.local/share/icons"
  mkdir -p "$HOME/.config/gtk-4.0"

  if [ -d "$src/.git" ]; then
    echo "Updating theme source: $src"
    git -C "$src" fetch --all --tags
  else
    rm -rf "$src"
    echo "Cloning theme source:"
    echo "  $repo"
    git clone "$repo" "$src"
  fi

  echo "Checking out pinned commit:"
  echo "  $commit"
  git -C "$src" checkout "$commit"

  if [ -d "$src/themes/$gtk_theme" ]; then
    rm -rf "$HOME/.local/share/themes/$gtk_theme"
    cp -r "$src/themes/$gtk_theme" "$HOME/.local/share/themes/"
    echo "Installed GTK theme: $gtk_theme"
  else
    echo "GTK theme directory not found: $src/themes/$gtk_theme"
  fi

  if [ -d "$src/icons/$icon_theme" ]; then
    rm -rf "$HOME/.local/share/icons/$icon_theme"
    cp -r "$src/icons/$icon_theme" "$HOME/.local/share/icons/"
    echo "Installed icon theme: $icon_theme"
    gtk-update-icon-cache -f "$HOME/.local/share/icons/$icon_theme" 2>/dev/null || true
  else
    echo "Icon theme directory not found: $src/icons/$icon_theme"
  fi

  if [ -d "$src/themes/$gtk_theme/gtk-4.0" ]; then
    cp -r "$src/themes/$gtk_theme/gtk-4.0/"* "$HOME/.config/gtk-4.0/" 2>/dev/null || true
    echo "Installed GTK4/libadwaita CSS"
  fi

  if [ "$dark" = "#t" ]; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
  fi

  [ -n "$gtk_theme" ] && gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
  [ -n "$icon_theme" ] && gsettings set org.gnome.desktop.interface icon-theme "$icon_theme"

  if command -v gnome-extensions >/dev/null 2>&1; then
    gnome-extensions enable user-theme@gnome-shell-extensions.gcampax.github.com 2>/dev/null || true
  fi

  [ -n "$shell_theme" ] && gsettings set org.gnome.shell.extensions.user-theme name "$shell_theme" 2>/dev/null || true

  echo
  echo "Theme applied."
  echo "Log out and back in to reload GNOME Shell on Wayland."
}

