cmd="${1:-}"
[ -n "$cmd" ] || { usage; exit 0; }
shift || true

event_one() {
  do_gc=0

  case "${1:-}" in
    --gc)
      do_gc=1
      shift
      ;;
    "")
      ;;
    *)
      die "usage: vanir event one [--gc]"
      ;;
  esac

  stamp="$(date +%Y%m%d-%H%M%S)"

  echo "== Vanir Event One =="
  echo "Unstable matter will be serialised into Core."
  echo "A pre-event record will be created before the timeline is altered."
  echo

  echo "== Recording pre-event state =="
  "$0" record "pre-event-one-$stamp" || true
  echo

  echo "== Serialising Guix user-profile packages =="
  "$0" serialise write
  echo

  echo "== Updating Core and Bifrost =="
  echo "Running: vanir update --all"
  echo

  if ! "$0" update --all; then
    echo
    echo "Event One failed during update/rebuild."
    echo "User-profile packages have NOT been removed."
    return 1
  fi

  echo
  echo "== Removing absorbed Guix user-profile packages =="
  "$0" serialise remove-user
  echo

  echo "== Re-integrating Core launchers =="
  "$0" core integrate || true
  echo

  echo "== Recording post-event state =="
  "$0" record "post-event-one-$stamp" || true
  echo

  if [ "$do_gc" -eq 1 ]; then
    echo "== Garbage collecting Core and Bifrost stores =="
    "$0" gc --all
    echo
  else
    echo "Skipping garbage collection."
    echo "Run later if wanted: vanir gc --all"
    echo
  fi

  echo "Event One complete."
}

starfield() {
  mode="${1:-install}"

  STAR_BIN="$HOME/.local/bin/terminus-starfield"
  STAR_DESKTOP="$HOME/.config/autostart/terminus-starfield.desktop"
  STAR_LOG="$HOME/.cache/terminus/starfield.log"

  case "$mode" in
    install|apply)
      mkdir -p "$HOME/.local/bin" "$HOME/.config/autostart" "$HOME/.cache/terminus"

      cat > "$STAR_BIN" <<'STARFIELD'
#!/usr/bin/env bash
set -u

LOG="$HOME/.cache/terminus/starfield.log"

{
  echo "== Vanir Starfield =="
  date
  echo "Waiting for GNOME session to settle..."

  sleep "${TERMINUS_STARFIELD_DELAY:-8}"

  echo
  echo "Applying aesthetics of the vessel."
  echo "Running: vanir theme repair"

  if [ -x "$HOME/.local/bin/vanir" ]; then
    "$HOME/.local/bin/vanir" theme repair
  else
    echo "vanir not found at $HOME/.local/bin/vanir"
  fi

  echo
  echo "Starfield complete."
  date
  echo
} >> "$LOG" 2>&1
STARFIELD

      chmod +x "$STAR_BIN"

      cat > "$STAR_DESKTOP" <<STARFIELD_DESKTOP
[Desktop Entry]
Type=Application
Name=Vanir Starfield
Comment=Apply the aesthetics of the Terminus vessel at login
Exec=$STAR_BIN
Terminal=false
X-GNOME-Autostart-enabled=true
NoDisplay=false
STARFIELD_DESKTOP

      echo "== Vanir Starfield =="
      echo "Login starfield installed."
      echo "Autostart: $STAR_DESKTOP"
      echo "Helper:    $STAR_BIN"
      echo "Log:       $STAR_LOG"
      echo
      echo "Running starfield once now."
      "$STAR_BIN"
      ;;

    run)
      if [ -x "$STAR_BIN" ]; then
        "$STAR_BIN"
      else
        die "starfield is not installed; run: vanir starfield"
      fi
      ;;

    status)
      echo "== Vanir Starfield status =="
      if [ -f "$STAR_DESKTOP" ]; then
        echo "Autostart installed: $STAR_DESKTOP"
      else
        echo "Autostart not installed."
      fi

      if [ -x "$STAR_BIN" ]; then
        echo "Helper installed: $STAR_BIN"
      else
        echo "Helper not installed."
      fi

      if [ -f "$STAR_LOG" ]; then
        echo
        echo "Recent starfield log:"
        tail -40 "$STAR_LOG"
      fi
      ;;

    disable)
      rm -f "$STAR_DESKTOP"
      echo "Vanir Starfield autostart disabled."
      ;;

    *)
      die "usage: vanir starfield [install|run|status|disable]"
      ;;
  esac
}

case "$cmd" in
  login-background)
    login_background "$@"
    ;;
  starfield)
    starfield "$@"
    ;;
  event)
    sub="${1:-}"
    shift || true

    case "$sub" in
      one) event_one "$@" ;;
      *) die "usage: vanir event one [--gc]" ;;
    esac
    ;;
  status) status ;;
  record) record "$@" ;;
  doctor) doctor ;;
  describe) describe ;;
  rebuild) rebuild "$@" ;;
  pull) pull ;;
  update) update "$@" ;;
  rollback) rollback ;;
  generations) generations "$@" ;;
  delete-generations) delete_generations "$@" ;;
  home) home "$@" ;;
  gc) gc "$@" ;;
  clean) clean "$@" ;;
  runes) runes ;;

  search)
    [ "$#" -gt 0 ] || die "usage: vanir search PACKAGE"
    if [[ "${1:-}" == bifrost:* ]]; then
      bifrost_search "${1#bifrost:}"
    else
      core_search "$@"
    fi
    ;;

  find)
    core_find "$@"
    ;;

  install)
    [ "$#" -gt 0 ] || die "usage: vanir install PACKAGE..."
    if [[ "${1:-}" == bifrost:* ]]; then
      first="${1#bifrost:}"
      shift || true
      bifrost_install "$first" "$@"
    else
      core_install "$@"
    fi
    ;;

  remove)
    [ "$#" -gt 0 ] || die "usage: vanir remove PACKAGE..."
    if [[ "${1:-}" == bifrost:* ]]; then
      first="${1#bifrost:}"
      shift || true
      bifrost_remove "$first" "$@"
    else
      core_remove "$@"
    fi
    ;;

  upgrade)
    core_upgrade "$@"
    ;;

  list)
    core_list
    ;;

  shell)
    [ "$#" -gt 0 ] || die "usage: vanir shell PACKAGE..."
    if [[ "${1:-}" == bifrost:* ]]; then
      first="${1#bifrost:}"
      shift || true
      bifrost_shell "$first" "$@"
    else
      core_shell "$@"
    fi
    ;;

  run)
    [ "$#" -gt 0 ] || die "usage: vanir run PACKAGE [COMMAND...]"
    if [[ "${1:-}" == bifrost:* ]]; then
      first="${1#bifrost:}"
      shift || true
      bifrost_run "$first" "$@"
    else
      core_run "$@"
    fi
    ;;

  serialise|serialize)
    sub="${1:-write}"
    shift || true

    case "$sub" in
      write|"") serialise_write ;;
      absorb) serialise_absorb ;;
      remove-user) serialise_remove_user_packages ;;
      status) serialise_status ;;
      file) serialise_file ;;
      *) die "usage: vanir serialise {write|absorb|remove-user|status|file}" ;;
    esac
    ;;

  theme)
    sub="${1:-status}"
    shift || true

    case "$sub" in
      init) theme_init ;;
      edit) ${EDITOR:-nano} "$THEME_CONFIG" ;;
      apply)
        theme_apply
        theme_enforce
        ;;
      enforce|repair)
        theme_enforce
        ;;
      status) theme_status ;;
      reset) theme_reset ;;
      *) die "usage: vanir theme {init|edit|apply|status|reset}" ;;
    esac
    ;;

  bifrost)
    sub="${1:-}"
    shift || true

    case "$sub" in
      init) bifrost_init ;;
      file) bifrost_file ;;
      edit) bifrost_edit ;;
      apply) bifrost_apply ;;
      sync) bifrost_sync ;;
      integrate) bifrost_integrate ;;
      channels) bifrost_channels ;;
      update) bifrost_update ;;
      search) bifrost_search "$@" ;;
      install) bifrost_install "$@" ;;
      remove) bifrost_remove "$@" ;;
      upgrade) bifrost_upgrade "$@" ;;
      list) bifrost_list ;;
      shell) bifrost_shell "$@" ;;
      run) bifrost_run "$@" ;;
      gc) bifrost_gc "$@" ;;
      optimise|optimize) bifrost_optimise ;;
      *) die "usage: vanir bifrost {init|file|edit|apply|sync|integrate|channels|update|search|install|remove|upgrade|list|shell|run|gc|optimise}" ;;
    esac   
    ;;

  record)
    record "$@"
    ;;

  core)
    sub="${1:-}"
    shift || true

    case "$sub" in
      integrate) core_integrate ;;
      *) die "usage: vanir core {integrate}" ;;
    esac
    ;;

  help|-h|--help)
    usage
    ;;

  *)
    die "unknown command: $cmd"
    ;;
esac
