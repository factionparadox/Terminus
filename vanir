SERIALISE_SYSTEM_FILE="/etc/terminus/serialised-packages.scm"
SERIALISE_USER_COPY="$HOME/.config/terminus/serialised-packages.scm"
SERIALISE_USER_LIST="$HOME/.config/terminus/serialised-packages.list"

vanir_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif [ -x /run/privileged/bin/sudo ]; then
    /run/privileged/bin/sudo "$@"
  else
    sudo "$@"
  fi
}

serialise_collect_user_packages() {
  guix package --list-installed \
    | awk 'NF { print $1 }' \
    | sort -u
}

serialise_write() {
  command -v guix >/dev/null 2>&1 || die "guix is not available"

  mkdir -p "$HOME/.config/terminus"

  serialise_collect_user_packages > "$SERIALISE_USER_LIST"

  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' RETURN

  {
    echo ";; -*- scheme -*-"
    echo ";; Generated by Vanir."
    echo ";; Source: Guix user profile package specifications."
    echo ";; Regenerate with: vanir serialise"
    echo
    echo "(use-modules (gnu packages))"
    echo
    echo "(define terminus-serialised-package-specifications"
    echo "  '("

    sed 's/\\/\\\\/g; s/"/\\"/g; s/.*/    "&"/' "$SERIALISE_USER_LIST"

    echo "    ))"
    echo
    echo "(define terminus-serialised-packages"
    echo "  (specifications->packages terminus-serialised-package-specifications))"
  } > "$tmp"

  cp "$tmp" "$SERIALISE_USER_COPY"

  vanir_root mkdir -p /etc/terminus
  vanir_root install -m 0644 "$tmp" "$SERIALISE_SYSTEM_FILE"

  echo "Serialised Guix user-profile packages into:"
  echo "  $SERIALISE_SYSTEM_FILE"
  echo
  echo "User copy:"
  echo "  $SERIALISE_USER_COPY"
}

serialise_remove_user_packages() {
  if [ ! -s "$SERIALISE_USER_LIST" ]; then
    echo "No serialised Guix user-profile packages to remove."
    return 0
  fi

  echo "Removing absorbed packages from Guix user profile..."

  pkgs="$(tr '\n' ' ' < "$SERIALISE_USER_LIST")"

  if [ -n "$pkgs" ]; then
    guix remove $pkgs
  fi

  echo
  echo "Absorbed packages removed from Guix user profile."
  echo "Run 'vanir gc' later to actually free old store paths."
}

serialise_absorb() {
  serialise_write

  echo
  echo "Rebuilding Terminus with serialised packages..."
  "$0" rebuild

  echo
  echo "Rebuild succeeded. Removing serialised packages from Guix user profile..."
  serialise_remove_user_packages

  echo
  echo "Serialise absorb complete."
}

serialise_status() {
  echo "Vanir serialise"
  echo "---------------"

  echo
  echo "Guix user-profile packages:"
  serialise_collect_user_packages | sed 's/^/  /'

  echo
  echo "System file:"
  if [ -f "$SERIALISE_SYSTEM_FILE" ]; then
    echo "  $SERIALISE_SYSTEM_FILE"
  else
    echo "  missing: $SERIALISE_SYSTEM_FILE"
  fi

  echo
  echo "User copy:"
  if [ -f "$SERIALISE_USER_COPY" ]; then
    echo "  $SERIALISE_USER_COPY"
  else
    echo "  missing: $SERIALISE_USER_COPY"
  fi

  echo
  echo "Last serialised package list:"
  if [ -f "$SERIALISE_USER_LIST" ]; then
    sed 's/^/  /' "$SERIALISE_USER_LIST"
  else
    echo "  missing: $SERIALISE_USER_LIST"
  fi
}

serialise_file() {
  if [ -f "$SERIALISE_USER_COPY" ]; then
    cat "$SERIALISE_USER_COPY"
  elif [ -f "$SERIALISE_SYSTEM_FILE" ]; then
    cat "$SERIALISE_SYSTEM_FILE"
  else
    die "no serialised package file found"
  fi
}

